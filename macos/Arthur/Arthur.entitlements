<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Status item + RegisterEventHotKey work without App Sandbox or an
	     Accessibility entitlement. Keep the existing mic + client network
	     grants; do not add listen-event / temporary-exception keys unless
	     the Carbon hotkey path is removed. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
